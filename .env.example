# 复制为项目根目录 .env 后填写（不要提交真实密钥到 git）
# cp .env.example .env

NODE_ENV=production

# —— MySQL ——
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ai_image_tool
MYSQL_USER=ycf
MYSQL_PASSWORD=change_me_db

# —— JWT ——
JWT_SECRET=change_me_jwt
JWT_REFRESH_SECRET=

# —— CORS ——
ALLOWED_ORIGINS=https://www.ycycf.com,http://www.ycycf.com,https://ycycf.com,http://ycycf.com,https://www.artycf.com,http://www.artycf.com

# —— AceData（生图/聊天等，按你现有配置补齐）——
ACE_API_KEY=
ACE_API_URL=https://api.acedata.cloud

# —— AI 质检 qc_web（Docker 内 Backend 会强制用 http://qc_web:8082）——
# 专用质检 Key；留空则 qc_web 容器回退使用 ACE_API_KEY
QC_API_KEY=
QC_API_BASE=https://api.acedata.cloud/v1
