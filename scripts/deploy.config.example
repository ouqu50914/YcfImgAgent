# 复制为 scripts/deploy.config 后填写（deploy.config 已 gitignore，勿提交）
# cp scripts/deploy.config.example scripts/deploy.config

# SSH 登录（可用 ~/.ssh/config 里的 Host 别名）
DEPLOY_SSH=root@你的服务器IP
# 例：DEPLOY_SSH=ubuntu@1.2.3.4
# 例：DEPLOY_SSH=ycf-prod   （需在 ~/.ssh/config 配置）

# 服务器上的项目目录（绝对路径）
DEPLOY_PATH=/opt/YcfImgAgent

# 可选：指定 SSH 私钥
# DEPLOY_SSH_KEY=~/.ssh/id_rsa

# 可选：rsync 额外参数
# DEPLOY_RSYNC_OPTS=--compress

# 是否把本地根目录 .env 也上传覆盖服务器（默认 0=否，保留服务器密钥）
# DEPLOY_SYNC_ENV=0

# 远程 compose 命令（新版 docker compose / 旧版 docker-compose）
DEPLOY_COMPOSE="docker compose -f docker-compose.prod.yml"
